{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compiler Debug",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-std=c++17",
                
                //"-g",
                "-O2",
                
                "${workspaceFolder}/main.cpp",

                "${workspaceFolder}/core/mappers/mbc1.c",
                "${workspaceFolder}/core/mappers/mbc2.c",
                "${workspaceFolder}/core/mappers/mbc3.c",
                "${workspaceFolder}/core/mappers/mbc5.c",
                "${workspaceFolder}/core/apu.c",
                "${workspaceFolder}/core/boot.c",
                "${workspaceFolder}/core/cartridge.c",
                "${workspaceFolder}/core/cpu.c",
                "${workspaceFolder}/core/dma.c",
                "${workspaceFolder}/core/gb.c",
                "${workspaceFolder}/core/interrupt.c",
                "${workspaceFolder}/core/joypad.c",
                "${workspaceFolder}/core/memory.c",
                "${workspaceFolder}/core/palette.c",
                "${workspaceFolder}/core/ppu.c",
                "${workspaceFolder}/core/serial.c",
                "${workspaceFolder}/core/timer.c",
                "${workspaceFolder}/core/utils.c",
                
                "-I${workspaceFolder}/imgui",

                "-L${workspaceFolder}/imgui/lib",

                "-limgui",
                "-lSDL2",

                "-o",
                "${workspaceFolder}/main"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "compilador: /usr/bin/clang++"
        },
        {
            "type": "cppbuild",
            "label": "ImGui build",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-O2",
                "-c",
                "${workspaceFolder}/imgui/imgui_demo.cpp",
                "${workspaceFolder}/imgui/imgui_draw.cpp",
                "${workspaceFolder}/imgui/imgui_impl_sdl2.cpp",
                "${workspaceFolder}/imgui/imgui_impl_sdlrenderer2.cpp",
                "${workspaceFolder}/imgui/imgui_tables.cpp",
                "${workspaceFolder}/imgui/imgui_widgets.cpp",
                "${workspaceFolder}/imgui/imgui.cpp",
            ],
            "options": {
                "cwd": "${workspaceFolder}/imgui/lib"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "compilador: /usr/bin/clang++"
        }
    ]
}