{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        
        {
            "label": "CMake Configure Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build/debug",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "env": {
                    "CC": "clang",
                    "CXX": "clang++"
                }
            },
            "group": "build"
        },

        {
            "label": "CMake Configure Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build/release",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "env": {
                    "CC": "clang",
                    "CXX": "clang++"
                }
            },
            "group":"build"
        },

        {
            "label": "CMake Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/debug",
            ],
            "group":"build"
        },

        {
            "label": "CMake Build Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/release",
            ],
            "group":"build"
        }
    ]
}